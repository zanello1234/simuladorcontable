{
  "name": "partida-doble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Partida Doble — simulador de estudio contable argentino",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:artifact": "npm run build:single && node scripts/artifact.mjs",
    "build:real": "vite build --mode real-single && node scripts/artifact.mjs dist-real/tablero.html dist-real/tablero-be-onlyone.html 'Tablero Be OnlyOne'",
    "dev:real": "vite --host --open /tablero.html"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
